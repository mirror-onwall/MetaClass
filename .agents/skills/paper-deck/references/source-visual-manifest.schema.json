{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metaclass.local/schemas/paper-deck/source-visual-manifest.schema.json",
  "title": "Paper Deck Source Visual Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "slides"],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "normalizedNumber": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slide_id", "order", "render_mode", "background_path", "assets", "annotations"],
      "properties": {
        "slide_id": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "render_mode": {
          "enum": ["native-raster", "source-grounded-hybrid"]
        },
        "background_path": {
          "type": "string",
          "pattern": "^images/[A-Za-z0-9._/-]+\\.(png|jpg|jpeg|webp)$"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "render_mode": {
                "const": "source-grounded-hybrid"
              }
            }
          },
          "then": {
            "properties": {
              "assets": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "source_path", "source_page", "figure_label", "x", "y", "w", "h", "fit", "crop", "preserve", "sha256"],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "pattern": "^provider_input/assets/[A-Za-z0-9._/-]+$"
        },
        "source_page": {
          "type": "integer",
          "minimum": 1
        },
        "figure_label": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/normalizedNumber"
        },
        "y": {
          "$ref": "#/$defs/normalizedNumber"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "fit": {
          "enum": ["contain", "cover"]
        },
        "crop": {
          "type": "string",
          "minLength": 1
        },
        "preserve": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[0-9a-fA-F]{64}$"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "type": {
          "enum": ["text", "rectangle", "arrow"],
          "default": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "$ref": "#/$defs/normalizedNumber"
        },
        "y": {
          "$ref": "#/$defs/normalizedNumber"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "font_name": {
          "type": "string",
          "minLength": 1
        },
        "font_size": {
          "type": "number",
          "minimum": 8,
          "maximum": 72
        },
        "bold": {
          "type": "boolean"
        },
        "align": {
          "enum": ["left", "center", "right"]
        },
        "color": {
          "type": "string",
          "pattern": "^#?[0-9a-fA-F]{6}$"
        },
        "line_color": {
          "type": "string",
          "pattern": "^#?[0-9a-fA-F]{6}$"
        },
        "line_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 12
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": ["text"]
          }
        },
        {
          "if": {
            "not": {
              "required": ["type"]
            }
          },
          "then": {
            "required": ["text"]
          }
        }
      ]
    }
  }
}
