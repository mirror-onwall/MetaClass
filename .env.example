# 默认无需设置，使用 data/runtime/metaclass.db。
# 部署 PostgreSQL 时安装 psycopg，并取消下面一行注释：
# METACLASS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/metaclass

# LLM 配置集中在 apps/api/src/metaclass/core/llm_config.py。
# 默认 provider=auto：没有 API key 时使用 fake，有 API key 时走 OpenAI-compatible。
# 可以直接编辑 llm_config.py，也可以在 .env 中覆盖：
# METACLASS_LLM_PROVIDER=openai-compatible
# METACLASS_LLM_BASE_URL=https://api.zhizengzeng.com/v1/
# METACLASS_LLM_API_KEY=sk-...
# METACLASS_LLM_MODEL=qwen3-32b
# METACLASS_LLM_TIMEOUT_SECONDS=60

# 材料解析：auto 会优先尝试 MinerU，失败后回退到本地 PyMuPDF/python-pptx。
# 如需强制使用 MinerU 并在环境异常时直接报错，设置为 mineru。
# METACLASS_MATERIAL_PARSER=auto
# METACLASS_MINERU_COMMAND=mineru
# METACLASS_MINERU_TIMEOUT_SECONDS=180
# METACLASS_LLM_TEMPERATURE=0.2
# METACLASS_LLM_MAX_TOKENS=8192
# Enable only when the configured OpenAI-compatible model accepts image inputs.
# METACLASS_VISION_ENABLED=false
# Optional: use a separate vision model. Defaults to LLM config.
# For Gemini native API:
# METACLASS_VISION_PROVIDER=gemini
# METACLASS_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# METACLASS_VISION_API_KEY=...
# METACLASS_VISION_MODEL=gemini-2.5-flash
# For OpenAI-compatible vision APIs:
# METACLASS_VISION_PROVIDER=openai-compatible
# METACLASS_VISION_BASE_URL=https://api.example.com/v1
# METACLASS_VISION_API_KEY=sk-...
# METACLASS_VISION_MODEL=qwen2.5-vl-72b-instruct
# METACLASS_VISION_TIMEOUT_SECONDS=120

# Embedding
# METACLASS_EMBEDDING_PROVIDER=local
# METACLASS_EMBEDDING_BASE_URL=https://api.zhizengzeng.com/v1/
# METACLASS_EMBEDDING_API_KEY=sk-...
# METACLASS_EMBEDDING_MODEL=text-embedding-3-small
# METACLASS_EMBEDDING_DIMENSION=1024
