# 默认无需设置，使用 data/runtime/metaclass.db。
# 部署 PostgreSQL 时安装 psycopg，并取消下面一行注释：
# METACLASS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/metaclass

# 默认使用 fake LLM，不会请求外部网络，适合本地测试。
METACLASS_LLM_PROVIDER=fake

# 后面接真实 OpenAI-compatible 接口时取消注释并填写：
# METACLASS_LLM_PROVIDER=openai-compatible
# METACLASS_LLM_BASE_URL=https://api.openai.com/v1
# METACLASS_LLM_API_KEY=sk-...
# METACLASS_LLM_MODEL=gpt-4o-mini
# METACLASS_LLM_TIMEOUT_SECONDS=60
