# 默认无需设置，使用 data/runtime/metaclass.db。
# 部署 PostgreSQL 时安装 psycopg，并取消下面一行注释：
# METACLASS_DATABASE_URL=postgresql+psycopg://user:password@host:5432/metaclass

# LLM 配置集中在 apps/api/src/metaclass/core/llm_config.py。
# 默认 provider=auto：没有 API key 时使用 fake，有 API key 时走 OpenAI-compatible。
# 可以直接编辑 llm_config.py，也可以在 .env 中覆盖：
# METACLASS_LLM_PROVIDER=openai-compatible
# METACLASS_LLM_BASE_URL=https://api.zhizengzeng.com/v1/
# METACLASS_LLM_API_KEY=sk-...
# METACLASS_LLM_MODEL=qwen3-32b
# METACLASS_LLM_TIMEOUT_SECONDS=60
# METACLASS_LLM_TEMPERATURE=0.2
# METACLASS_LLM_MAX_TOKENS=8192

# Embedding 目前预留，暂未接入检索链路：
# METACLASS_EMBEDDING_PROVIDER=local
# METACLASS_EMBEDDING_MODEL_PATH=/sdd/chenluyuan/ckpt/bge-m3
# METACLASS_EMBEDDING_DIMENSION=1024
