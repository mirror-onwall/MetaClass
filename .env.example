# Copy this file to .env. The defaults run locally without external API keys.

# Storage and database
METACLASS_DATA_DIR=data
# METACLASS_DATABASE_URL=sqlite:///data/runtime/metaclass.db

# LLM: fake | openai-compatible
METACLASS_LLM_PROVIDER=fake
METACLASS_LLM_BASE_URL=https://api.openai.com/v1
METACLASS_LLM_API_KEY=
METACLASS_LLM_MODEL=gpt-4o-mini
METACLASS_LLM_TIMEOUT_SECONDS=180
METACLASS_LLM_TEMPERATURE=0.2
METACLASS_LLM_MAX_TOKENS=8192

# Classroom question generation
METACLASS_QA_STUDENT_CONCURRENCY=3
METACLASS_QA_CANDIDATES_PER_SLIDE=4

# Material parsing: auto | builtin | mineru
METACLASS_MATERIAL_PARSER=auto
METACLASS_MINERU_COMMAND=mineru
METACLASS_MINERU_TIMEOUT_SECONDS=180

# Optional vision model. Provider can be gemini or openai-compatible.
METACLASS_VISION_ENABLED=false
METACLASS_VISION_PROVIDER=
METACLASS_VISION_BASE_URL=
METACLASS_VISION_API_KEY=
METACLASS_VISION_MODEL=
METACLASS_VISION_TIMEOUT_SECONDS=180

# Embeddings: local | openai-compatible
METACLASS_EMBEDDING_PROVIDER=local
METACLASS_EMBEDDING_MODEL_PATH=
METACLASS_EMBEDDING_BASE_URL=https://api.openai.com/v1
METACLASS_EMBEDDING_API_KEY=
METACLASS_EMBEDDING_MODEL=text-embedding-3-small
METACLASS_EMBEDDING_DIMENSION=1024

# TTS: fake | openai-compatible | minimax
METACLASS_TTS_PROVIDER=fake
METACLASS_TTS_BASE_URL=
METACLASS_TTS_API_KEY=
METACLASS_TTS_MODEL=tts-1
METACLASS_TTS_TEACHER_VOICE=alloy
METACLASS_TTS_STUDENT_VOICES=ash,ballad,coral,echo,fable,nova,onyx,shimmer
METACLASS_TTS_TIMEOUT_SECONDS=180

# PPT: codex | presenton | local
METACLASS_PPT_PROVIDER=codex
CODEX_API_KEY=
METACLASS_CODEX_MODEL=
METACLASS_CODEX_TIMEOUT_SECONDS=900
METACLASS_CODEX_REPAIR_ATTEMPTS=2
# Use the repository-pinned paper-craft skills for one generated 16:9 visual background per slide.
# Exact PresentationPlan text is overlaid as editable PPT text; order and scripts stay authoritative.
METACLASS_CODEX_PAPER_CRAFT_ENABLED=true
# Deck-wide safety cap. The default covers presentations up to 24 slides.
METACLASS_CODEX_PAPER_CRAFT_MAX_IMAGES=24
# Independent per-slide Codex/imagegen sessions run with bounded concurrency.
METACLASS_CODEX_PAPER_CRAFT_CONCURRENCY=2
# Defaults to <repository>/.agents/skills. Use an absolute path when overriding it.
# METACLASS_CODEX_PAPER_CRAFT_SKILLS_DIR=

# Optional cross-platform PPTX preview renderers.
# macOS external decks try Keynote, then LibreOffice; Windows tries PowerPoint first.
METACLASS_LIBREOFFICE_BIN=

# Optional Presenton provider or Codex fallback
PRESENTON_BASE_URL=https://api.presenton.ai
PRESENTON_API_KEY=
METACLASS_PRESENTON_TIMEOUT_SECONDS=300
METACLASS_PRESENTON_TEMPLATE=general
